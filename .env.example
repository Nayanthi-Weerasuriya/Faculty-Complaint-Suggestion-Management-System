# Template only. Copy to .env, replace placeholders, then load with scripts/load-environment.ps1.
# .env is private and ignored by Git. Values are literal; do not use inline comments.
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_50_CHARACTERS
DJANGO_ALLOWED_HOSTS=portal.example.edu
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.edu
# Enable only behind a configured trusted HTTPS proxy.
DJANGO_TRUST_PROXY_HTTPS=false
# Enable these only after approval for domain-wide HTTPS and browser preloading.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_HSTS_PRELOAD=false
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.edu
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_WITH_SMTP_USERNAME
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
DEFAULT_FROM_EMAIL=portal@example.edu
LOCAL_EMAIL_PREVIEW_ENABLED=false
